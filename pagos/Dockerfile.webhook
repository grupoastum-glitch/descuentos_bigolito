# Servicio siempre activo: recibe los webhooks de MercadoPago. Ver Dockerfile.reconciliacion
# para el cron diario (mismo código, distinto entrypoint).
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pagos/requirements.txt pagos/requirements.txt
RUN pip install --no-cache-dir -r pagos/requirements.txt

COPY pagos/config.py pagos/config.py
COPY pagos/config_canales.py pagos/config_canales.py
COPY pagos/db.py pagos/db.py
COPY pagos/logica.py pagos/logica.py
COPY pagos/mercadopago_client.py pagos/mercadopago_client.py
COPY pagos/pagos_tarjeta.py pagos/pagos_tarjeta.py
COPY pagos/precios.py pagos/precios.py
COPY pagos/telegram_client.py pagos/telegram_client.py
COPY pagos/webhook.py pagos/webhook.py
COPY web/data/ web/data/

WORKDIR /app/pagos
CMD ["python", "webhook.py"]
