TELEGRAM_BOT_TOKEN=coloca_aqui_el_token_que_te_da_botfather
DATABASE_URL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SUSCRIPCION_MONTO=1000
MERCADOPAGO_SUSCRIPCION_FRECUENCIA=1
MERCADOPAGO_SUSCRIPCION_FRECUENCIA_TIPO=days
# secreto para firmar el link de pago con tarjeta (ver bot.py::_firmar_link_tarjeta) — mismo
# valor que LINK_PAGO_SECRET en pagos/.env, generado una sola vez.
LINK_PAGO_SECRET=
# telegram_user_id del admin — habilita el comando oculto /stats (ver bot.py::cmd_stats) solo
# para esa cuenta. Si falta, /stats queda deshabilitado y el bot arranca igual.
BOT_ADMIN_TELEGRAM_USER_ID=
# canal privado admin-only donde se avisa cada activación de prueba gratis (ver
# bot.py::cb_probar_gratis) — mismo canal e ID que TELEGRAM_ADMIN_CHAT_ID_PAGOS en pagos/.env
# ("Subs Bigolito💰"). Opcional: si falta, esas activaciones simplemente no se avisan ahí.
TELEGRAM_ADMIN_CHAT_ID_PAGOS=
